#!/usr/bin/env bash
set -euo pipefail

# cc - Claude Code ランチャー
# セッション選択 + タスク入力のみ

CLAUDE_CMD="${CLAUDE_CMD:-claude}"

if [[ "${1:-}" == "-f" && -n "${2:-}" ]]; then
  [[ -f "$2" ]] || { echo "File not found: $2" >&2; exit 2; }
  exec "$CLAUDE_CMD" -- "$(cat "$2")"
elif [[ -n "${*:-}" ]]; then
  exec "$CLAUDE_CMD" -- "$*"
elif [[ ! -t 0 ]]; then
  exec "$CLAUDE_CMD" -- "$(cat)"
else
  echo "セッションを選択:"
  echo "  1) 新規セッション"
  echo "  2) 既存セッションを継続"
  echo -n "[1/2]: "
  read -r choice
  case "$choice" in
    2) exec "$CLAUDE_CMD" --resume ;;
    1|"") exec "$CLAUDE_CMD" ;;
    *) echo "無効な選択です" >&2; exit 1 ;;
  esac
fi
